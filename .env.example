# ==========================================
# ROYALORA E-COMMERCE ENVIRONMENT CONFIGURATION
# ==========================================

# Public Brand Details
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="ROYALORA"
NEXT_PUBLIC_BRAND_TAGLINE="A Royal Touch of Nutrition."

# Razorpay Payment Gateway (Indian Rupee INR)
# Sign up at https://dashboard.razorpay.com/ to retrieve your API Keys
# When left as test placeholders, the website runs in simulated Sandbox Test Mode
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Optional Database / Supabase configuration for persistent cloud catalog
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Concierge Email Configuration (Resend, SendGrid, or Nodemailer)
# EMAIL_SERVER_USER=care@royalora.com
# EMAIL_SERVER_PASSWORD=your_smtp_password
# EMAIL_SERVER_HOST=smtp.sendgrid.net
# EMAIL_SERVER_PORT=587
# EMAIL_FROM=care@royalora.com
